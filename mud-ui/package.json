{
  "name": "mud-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsup",
    "dev": "npm-run-all -p dev:build dev:serve",
    "dev:build": "tsup --config tsup.dev.config.ts --watch",
    "dev:serve": "web-dev-server --root-dir dev --port 3000 --watch --open /index.html",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
"devDependencies": {
    "@web/dev-server": "^0.4.5",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "tsup": "^8.1.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.4"
  }
}